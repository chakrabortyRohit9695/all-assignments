{
  "mcpServers": {
    "kite": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/index.js"],
      "env": {
        "KITE_API_KEY": "${KITE_API_KEY}",
        "KITE_API_SECRET": "${KITE_API_SECRET}",
        "KITE_ACCESS_TOKEN": "${KITE_ACCESS_TOKEN}",
        "KITE_ALLOW_TRADING": "${KITE_ALLOW_TRADING:-false}"
      }
    }
  }
}
